# ROBOT ENVIRONMENT -- the single source of truth for BOTH the robot and sim.
#
# TEMPLATE (frozen-G1 TOKEN set). Copy to x2_pc2/robot_env.env, edit the MODEL lines
# (X2_RITUAL_MODEL / X2_WB_TOKEN_MODEL / X2_WB_TOKENIZER) to your own exported
# ONNX files, then stage it on PC2 with pc2_bringup.sh or push_to_pc2.sh
# (both copy x2_pc2/robot_env.env -> ${PC2_PREFIX}/robot_env.env).
# x2_pc2/robot_env.env itself is per-robot and NOT committed.
#
# WHY ONE FILE: this is sourced by ritual_start_demo.sh / ritual_start_sonic.sh
# (the kplanner daemon) AND by start_x2_deploy_ritual.sh (the SONIC deploy),
# so planner knobs, the tuning preset, the anchor-orientation convention and
# the model paths all live here. Ignition is the pad chord, so this is the
# only injection point -- there is never a keyboard to export from.
# Sim runs (simstack_*.sh, gear_sonic/scripts/simstack_local.sh) source the
# same file, so sim cannot silently diverge from the robot (X2_ANCHOR_ORI_MODE
# once did exactly that: sim sourced a planner-only profile and never saw it).
#
# ":=" idiom throughout: a variable already exported in the environment wins
# over the value here, so one-off overrides remain possible.

# Robot install prefix (pc2_bringup.sh --prefix). Everything below resolves
# against it, so relocating the install is this one line.
: "${PC2_PREFIX:=/home/run/gear-sonic}"
export PC2_PREFIX

# --- planner locomotion setpoints (robot-verified baseline) -----------------
# In-place turn rate. 1.0 felt much faster on the robot than in MuJoCo;
# 0.55 was sluggish; 0.65 is the operator-settled value. Walking-arc turns
# are fine at 0.70.
: "${KPLANNER_FIXED_TURN_RAD_S:=0.65}"
: "${KPLANNER_FIXED_FWD_MPS:=0.35}"
: "${KPLANNER_FIXED_ARC_TURN_RAD_S:=0.70}"

# --- stop chain ---------------------------------------------------------------
: "${KPLANNER_STOP_BRAKE_PULSE_S:=0.55}"
# foot-align cut + approach slowdown + XY continuation are code defaults.
# Escape hatch if the robot dislikes any of it: KPLANNER_LEGACY_IMMEDIATE_STOP=1

# --- slow-walk floors (sim-verified at 0.15-0.2) -------------------------------
: "${KPLANNER_CONTINUOUS_FWD_MIN_MPS:=0.2}"
: "${KPLANNER_SPEED_SETPOINT_MIN:=0.2}"

# NOTE on heading resync: the daemon's DEFAULT is measured-yaw rebase ON
# (assignment-form, idle-only) and the ritual passes no --no-yaw-rebase, so
# the robot always runs with it. KPLANNER_YAW_REBASE below exists only for
# SIM stacks (whose launcher force-disables rebase unless env=1); it is NOT
# read on PC2. The resync is what PREVENTS "perturbation resets robot to
# world orientation" (see _resync_idle_yaw_from_measured).

# --- experiments: HARD OFF on robot ------------------------------------------
: "${KPLANNER_SIDE_STEP_PRIMITIVE:=0}"

# --- deploy tuning preset --------------------------------------------------
# THE tuning switch. start_x2_deploy_ritual.sh sources this file, so the pad
# chord ignition picks the preset up. Presets live in
# gear_sonic_deploy/configs/real_deploy_tuning/ (README.md there explains the
# ladder). Pair the preset with the model lineage:
#   trained_gains_s0.yaml  unity kp/kd scales: vendor-plant (S0 and later)
#                          models whose trained gains ARE the vendor base gains.
#   bigrun.yaml            the scale stack for legacy-trained (pre-vendor-plant)
#                          models; gantry-verified, never edited.
# Softening rungs (hip 0.60-0.80, knee 1.00) were tested on hardware and closed:
# kp scaling does not bound torque (tracking error grows to compensate), and a
# softened hip shifts the load to the knee. Do not reach for them.
: "${X2_RITUAL_TUNING:=${PC2_PREFIX}/gear_sonic_deploy/configs/real_deploy_tuning/trained_gains_s0.yaml}"

# Black-box history retained on a trip. start_x2_deploy_ritual.sh defaults
# to 30 s; the event of interest typically sits a few seconds before an
# e-stop the operator takes several seconds to call, so 60 s.
: "${X2_FLIGHT_SECONDS:=60}"
export X2_FLIGHT_SECONDS

export KPLANNER_FIXED_TURN_RAD_S KPLANNER_FIXED_FWD_MPS \
  KPLANNER_FIXED_ARC_TURN_RAD_S KPLANNER_STOP_BRAKE_PULSE_S \
  KPLANNER_CONTINUOUS_FWD_MIN_MPS KPLANNER_SPEED_SETPOINT_MIN \
  KPLANNER_SIDE_STEP_PRIMITIVE X2_RITUAL_TUNING

# --- anchor-orientation convention ------------------------------------------
# WHICH FRAME THE POLICY'S REFERENCE ORIENTATION IS EXPRESSED IN. The tokenizer
# feeds the policy 10 future reference frames as a 6D rotation "how far is the
# reference rotated from me". There are TWO ways to define "from me", they are
# BOTH 60 floats, and picking the wrong one raises NOTHING.
#
#   body     normalise the reference by the robot's FULL orientation, pitch and
#            roll included  ->  obs term motion_anchor_ori_b_mf_nonflat.
#            Aliases: body_frame, and the legacy "b" (the letter in the training
#            observation name). Prefer "body".
#   heading  normalise by YAW ONLY, preserving the reference's pitch/roll
#            relative to gravity  ->  motion_anchor_ori_heading_mf_nonflat.
#
# The two agree EXACTLY when the robot is upright and diverge 1:1 with its own
# tilt (0 deg standing, 10 deg at a 10 deg lean). A wrong setting survives every
# gentle bring-up rung and only bites once the robot leans -- turns under load,
# crouches, dances. THE MODEL DECIDES THIS, NOT THE OPERATOR. Check before every
# model swap; the export stamps the obs contract in the ONNX metadata:
#   python gear_sonic/scripts/onnx_obs_contract.py MODEL.onnx --require body
# exit 0 = the model and this setting agree; exit 1 = mismatch, do not run.
# Native 3-encoder (dual-head / _g1 + _token) exports use "body".
# The deploy binary REJECTS unrecognised values instead of silently choosing.
: "${X2_ANCHOR_ORI_MODE:=body}"
export X2_ANCHOR_ORI_MODE

# --- policy -----------------------------------------------------------------
# FROZEN-G1 TOKEN set: X2_RITUAL_MODEL is the pose graph (<name>_g1.onnx);
# whole-body teleop runs through the PC2 token service (pc2_pico_token_service.py)
# with a separate token-overlay graph and an smpl->token tokenizer. The ritual
# refuses to launch when the actor and tokenizer carry DIFFERENT codec_fingerprint
# stamps (different codec generations -> the robot would ignore the operator);
# X2_ALLOW_CODEC_MISMATCH=1 overrides for deliberate cross-era experiments.
# Export the three graphs from ONE checkpoint (MODELS.md) and stage them under
# ${PC2_PREFIX}/policies/. The ritual's default (policies/agibot_x2_sonic.onnx)
# is deliberately NOT used: naming the file here keeps rollbacks one-line edits.
: "${X2_RITUAL_MODEL:=${PC2_PREFIX}/policies/x2_sonic_s1ft16000_g1.onnx}"
export X2_RITUAL_MODEL
# Whole-body release stability (docs/source/references/x2_whole_body_dual_head.md):
# kplanner shadow -> hold -> rate-limited return; HOLD_LEGS=1 pairs with the
# dual deploy's own hold (the kplanner's RETURN on a pad intent is the
# deploy's hand-over signal).
: "${KPLANNER_WB_RETURN:=1}"
: "${KPLANNER_WB_HOLD_LEGS:=1}"
export KPLANNER_WB_RETURN KPLANNER_WB_HOLD_LEGS
# Arm latch during a gait while whole-body is engaged: keep = the latched arm
# pose rides through the walk (operator default, same as the sim runbook);
# release = the kplanner code default.
: "${KPLANNER_WB_ARM_LATCH_GAIT:=keep}"
export KPLANNER_WB_ARM_LATCH_GAIT
# Token overlay graph must PAIR with the pose graph above (same checkpoint).
: "${X2_WB_TOKEN_MODEL:=${PC2_PREFIX}/policies/x2_sonic_s1ft16000_g1_token.onnx}"
export X2_WB_TOKEN_MODEL
# smpl->token tokenizer the PC2 token service runs; must pair with the two above.
: "${X2_WB_TOKENIZER:=${PC2_PREFIX}/policies/x2_smpl_tokenizer_v11release.onnx}"
export X2_WB_TOKENIZER
# --- actuator plant ---------------------------------------------------------
# WHICH ACTUATOR PLANT (armature / effort / PD / action_scale) the tooling uses.
# The deploy binary's compiled tables (policy_parameters.hpp, stamped
# "[plant: vendor_20260823]") are what runs unless X2_PLANT / X2_PLANT_YAML
# resolve a gear_sonic/config/robot_plant/x2_ultra_<name>.yaml at start-up
# (then the binary loads that yaml and REFUSES to start if the named plant
# has no yaml). The Python/MuJoCo side (plant_config.py, eval_x2_mujoco.py)
# reads the same variable, so pinning it here keeps sim and robot on one plant.
#   available: vendor_20260823 | legacy_pre20260823
: "${X2_PLANT:=vendor_20260823}"
export X2_PLANT

# --- sim-parity knobs (no-ops on the robot, REQUIRED in sim) -----------------
# KPLANNER_YAW_REBASE: measured-yaw rebase is the daemon's DEFAULT (idle-only)
# on the robot; the SIM launcher force-DISABLES rebase unless this is 1.
: "${KPLANNER_YAW_REBASE:=1}"
# KPLANNER_REPLAN_THRESHOLD_FRAMES: AUTHORITATIVE for robot AND sim. The ritual
# reads it as ${KPLANNER_REPLAN_THRESHOLD_FRAMES:?} -- an assertion, not a
# default: if this file fails to define it the daemon refuses to start with a
# named reason. 48 is the robot value (pc2_kplanner_onnx.py's argparse default
# is 32; the sim stack defaults to 2).
: "${KPLANNER_REPLAN_THRESHOLD_FRAMES:=48}"
export KPLANNER_YAW_REBASE KPLANNER_REPLAN_THRESHOLD_FRAMES

# --- whole-body Pico teleop overlay (HYBRID) -----------------------------------
# X2_WHOLE_BODY_TELEOP=1 ARMS the overlay: the pad/kplanner session stays
# PRIMARY; the operator's pose drives only while the laptop stream is fresh
# AND the operator holds engagement (grips). Disengage or wifi loss = the pad
# has authority again instantly, so armed-but-disengaged is behaviourally a
# plain pad session. DEFAULT 1: the operator has only the gamepad at the
# robot; this must never require a runtime toggle. Laptop side:
#   ./gear_sonic/scripts/run_pico_teleop.sh
: "${X2_WHOLE_BODY_TELEOP:=1}"
# The teleop laptop's address, informational: the laptop's pico_token_sender.py
# CONNECTS to PC2 (:5573), nothing on PC2 dials the laptop. Set LAPTOP_HOST in
# the environment or write <LAPTOP_IP> here for the operator log.
: "${X2_WB_LAPTOP_HOST:=${LAPTOP_HOST:-<LAPTOP_IP>}}"
export X2_WHOLE_BODY_TELEOP X2_WB_LAPTOP_HOST
