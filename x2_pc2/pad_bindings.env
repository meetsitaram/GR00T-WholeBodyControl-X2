# SINGLE SOURCE OF TRUTH for gamepad semantics -- sourced by BOTH the robot
# ritual (x2_pc2/ritual_start_demo.sh / ritual_start_sonic.sh) and the local
# sim stack (gear_sonic/scripts/simstack_local.sh), so the pad FEELS the same
# in sim rehearsal and on the robot. Edit HERE, never inline in a launcher
# (a rehearsal once shipped stale copied bindings: deadman=both instead of the
# operator's deadman=left, and no dance banks at all).
#
# CLIP KEYS MUST MATCH THE CLIPS IN THE DEPLOYED DANCE DIR
# (${PC2_PREFIX}/planner_stack/models/dances_x2m2/<key>.x2m2, and the same
# keys in gear_sonic/data/motions/x2_demo_bank.pkl / x2_pad_banks.pkl for the
# sim stack). The keys below are the upstream demo bank produced by
# tools/build_demo_bank_from_upstream.sh (manifest/REGENERATE.md): the
# gear_sonic_deploy/reference/example/* clip names plus their _M mirrors.
# A key that has no clip in the dir is silently unbound by the pad bridge --
# after regenerating or extending the bank, re-check every list here.
# Banks are ENABLE lists: the .x2m2 bakes stay in the bank dir, so
# enabling/disabling a clip = editing its key in/out of the string.

PAD_DEADMAN="left"                # L2 alone arms the sticks (operator standard)
PAD_LOCK_SPEED=1                  # fixed speed setpoint; L1/R1 do not retune

# One bank per face button (deadman RELEASED): Y=easy A=gestures X=combat B=medium
# Clip banks ship EMPTY: no bundled dance/combat/turn clips (no third-party motion data in this repo).
# GESTURES = the X2 Motion-Controller stock gestures captured on the robot (gear_sonic/data/motions/x2_recorded/mc_gestures/).
# Fill a bank with keys present in the deployed dances dir to enable it.
EASY_DANCES=""
COMBAT=""
MEDIUM=""
# RIGHT-STICK 4-way (deadman RELEASED), POSITIONAL: LEFT,RIGHT,UP,DOWN.
# LEFT/RIGHT fire on entry; UP/DOWN need a 2 s hold. The _M mirror is the
# opposite turn direction of its source clip.
TURNS=""
# Gestures on L1+A (cycles forward). squat_001 is the crouch-style gesture.
GESTURES="right_wave_001,right_kiss_001,right_five_001,right_shake_001,turn_wave_right_001,turn_wave_left_001"
PAD_CLIP_DPAD_UP=""

# 8-way MICRO-STEP replay bank: RIGHT TRIGGER held + LEFT stick, left-trigger deadman released; order F,B,L,R,FL,FR,BL,BR
# (empty = disabled). Entries are POSITIONAL; an empty slot leaves that direction unbound. "prim:<name>" plays a
# kplanner PRIMITIVE from x2_planner_primitives.pkl (root XY persists) instead of an x2m2 clip
# (the clip player pins the pelvis -> stepping clips become foot slides). Disabled here because the
# regenerated primitives pkl carries no step primitives; bind "prim:<name>" entries only for names
# present in your x2_planner_primitives.pkl.
MICRO=""

# CROUCH MODE, HOLD-TO-CROUCH: BOTH triggers (L2+R2) held + D-pad DOWN = ARM; crouched only while
# both triggers stay held -- releasing either (or D-pad UP) = standing at once. Kplanner gates the entry (standing still)
# and crouches FORWARD/TURN targets only (hip KPLANNER_CROUCH_HIP_M 0.55 -> pelvis ~0.57 m); standing still, backward and
# lateral stay at the standing hip; auto-OFF 0.6 s without the pad keepalive, on E-STOP, or a whole-body engage.
# Only the G1-core planner has a crouch template (hip < 0.60); the incumbent template planner ignores the hip.
# Robot-verified 2026-09-09 (frozen core, six crouched walks); depth varies with the sampler seed -> KPLANNER_CROUCH_SEED.
# The sim twin tips at the crouch stop (it cannot hold the robot's deep crouch) -- qualify on the robot, not in sim.
export KPLANNER_CROUCH_HIP_M=0.55
