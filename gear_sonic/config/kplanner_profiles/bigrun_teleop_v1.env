# kplanner profile: bigrun_teleop_v1 (2026-08-09)
# One named, versioned, reviewable set of runtime knobs. Loaded via
#   KPLANNER_PROFILE=gear_sonic/config/kplanner_profiles/bigrun_teleop_v1.env
# The ":=" idiom means an env you set EXPLICITLY on the command line always
# wins over the profile -- profiles are defaults, not overrides.
#
# Captures the operator-tuned state from the 2026-08-09 sim session:
# cap-offset fix + model-stop (decay law + foot-align + brake pulse) +
# speed floor opened to 0.2 + idle yaw rebase ON.
# Robot-shipping rule: copy this file to PC2 alongside the daemon, md5 both
# sides (feedback_robot_files_in_repo), run preflight_planner.py first.

# --- heading / turn ---
: "${KPLANNER_YAW_REBASE:=1}"
: "${KPLANNER_FIXED_ARC_TURN_RAD_S:=0.70}"
: "${KPLANNER_FIXED_TURN_RAD_S:=0.55}"

# --- speed ---
: "${KPLANNER_FIXED_FWD_MPS:=0.35}"
: "${KPLANNER_CONTINUOUS_FWD_MIN_MPS:=0.2}"
: "${KPLANNER_SPEED_SETPOINT_MIN:=0.2}"

# --- stop chain (operator-tuned 2026-08-09) ---
: "${KPLANNER_STOP_BRAKE_PULSE_S:=0.55}"
# defaults already good: KPLANNER_STOP_FOOT_ALIGN=1, STOP_ALIGN_SLOW=0.35,
# MODEL_STOP_MIN_MPS=0.20, SETTLED=0.22, ZERO_SNAP=0.30

# --- replan ---
: "${KPLANNER_REPLAN_THRESHOLD_FRAMES:=48}"

# --- experiments (OFF for robot; flip consciously) ---
: "${KPLANNER_SIDE_STEP_PRIMITIVE:=0}"

export KPLANNER_YAW_REBASE KPLANNER_FIXED_ARC_TURN_RAD_S \
  KPLANNER_FIXED_TURN_RAD_S KPLANNER_FIXED_FWD_MPS \
  KPLANNER_CONTINUOUS_FWD_MIN_MPS KPLANNER_SPEED_SETPOINT_MIN \
  KPLANNER_STOP_BRAKE_PULSE_S KPLANNER_REPLAN_THRESHOLD_FRAMES \
  KPLANNER_SIDE_STEP_PRIMITIVE
