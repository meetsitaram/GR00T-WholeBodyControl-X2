# g1core_bare_v1 — MINIMAL daemon plumbing for the wrapped G1 2M core
# (frozen-core). Hypothesis (operator, 2026-08-12): the compensation layers
# accumulated for the UNDERTRAINED X2 planners hinder the well-trained
# core. This profile neutralizes the COMPENSATIONS and keeps the
# CORRECTNESS/SAFETY fixes (seam yaw align, cap-offset, watchdog rebase
# are bug fixes, not tuning). A/B against bigrun_teleop_v1.env.
#
# ":=" idiom: explicit env still wins over this file.

# --- compensations for old-planner stop dynamics: OFF/neutral ---
: "${KPLANNER_STOP_BRAKE_PULSE_S:=0}"        # brake pulse (old stop overshoot)
: "${KPLANNER_STOP_LATCH_MAX_TICKS:=0}"      # knee latch (sized on OLD stop poses;
                                             # new core cuts stops at ~31 deg knee)
# --- compensations for old-planner speed dead-band: OFF ---
: "${KPLANNER_CONTINUOUS_FWD_MIN_MPS:=0}"
: "${KPLANNER_SPEED_SETPOINT_MIN:=0}"
# --- old-planner gait workarounds: OFF ---
: "${KPLANNER_SIDE_STEP_PRIMITIVE:=0}"       # discrete side-step (planner can strafe)
: "${KPLANNER_REF_SMOOTHER_MS:=0}"           # step-transition smoother
# --- speed/turn setpoints: same as bigrun profile (fair A/B) ---
: "${KPLANNER_FIXED_FWD_MPS:=0.35}"
: "${KPLANNER_FIXED_ARC_TURN_RAD_S:=0.70}"
: "${KPLANNER_FIXED_TURN_RAD_S:=0.55}"
: "${KPLANNER_REPLAN_THRESHOLD_FRAMES:=48}"
# --- kept AS-IS (correctness/safety, not compensation) ---
# KPLANNER_YAW_REBASE is read by the WATCHDOG, not the daemon — set at launch env
: "${KPLANNER_SEAM_YAW_ALIGN:=1}"            # replan-seam heading bug fix
: "${KPLANNER_COLD_START_RAMP_TAU_S:=0.6}"   # input shaping; sweep separately
