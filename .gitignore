# Local motion libraries (rebuilt from upstream reference clips by
# tools/build_demo_bank_from_upstream.sh and build_x2_planner_primitives.py;
# tens to hundreds of MB each, regenerable, not source-of-truth for the
# repo). Recipes that produce them ARE tracked
# (see gear_sonic/data/motions/x2_planner_primitives_recipes.yaml etc).
gear_sonic/data/motions/*.pkl
# shipped-with-repo exceptions (LFS):
!gear_sonic/data/motions/kplanner_idle_anchor_g1teleop_v3.pkl

# Training output logs
logs_rl/
logs_eval/

# Model checkpoints directory
models/
# Shipped default X2 set (git-lfs; see gear_sonic_deploy/models/README.md).
# The directory is re-included so the blanket *.onnx rule above can be
# negated for exactly these four graphs; everything else under it stays
# ignored (it is the docker sim's default X2_CHECKPOINTS_DIR mount).
!/gear_sonic_deploy/models/
!/gear_sonic_deploy/models/x2_sonic_v16ft8_45000_dual.onnx
!/gear_sonic_deploy/models/x2_sonic_v16ft8_45000_g1.onnx
!/gear_sonic_deploy/models/x2_sonic_v16ft8_45000_g1_token.onnx
!/gear_sonic_deploy/models/x2_sonic_v16ft8_45000_smpl_tokenizer.onnx
!/gear_sonic_deploy/models/x2_sonic_v16ft8_45000.manifest.txt
!gear_sonic_deploy/models/x2_sonic_s1ft16000_g1.onnx
!gear_sonic_deploy/models/x2_sonic_s1ft16000_g1_token.onnx
!gear_sonic_deploy/models/x2_smpl_tokenizer_v11release.onnx
!gear_sonic_deploy/models/x2_sonic_s1ft16000.manifest.txt
!gear_sonic_deploy/models/x2_sonic_s1ft16000_g1.onnx.phi.json
!gear_sonic_deploy/models/x2_sonic_s1ft16000_g1.onnx.provenance.json
!/gear_sonic_deploy/models/kplanner_g1core_s1d_heads.pt

# Downloaded from HuggingFace (hf download)
sample_data/
sonic_release/

# X2 deploy: per-run robot logs (binary obs dumps, tick.csv, target_pos.csv,
# joint_pos.csv etc). Generated under logs/x2/<runtag>/ by deploy_x2.sh and
# the offline parity tools. They're large (tens of MB per run), regenerated
# on every smoke test, and only useful in the originating workspace.
logs/x2/

# Generic per-workstation scratch space used by debugging tools (e.g.
# obs-dump blobs, ad-hoc captures). Never check in.
scratch/

# X2 MC-motor scan output (gear_sonic_deploy/scripts/x2_scan_mc_motors.sh).
# Each run drops one mc_motor_scan_<unix_ts>.jsonl in the working
# directory (typically the repo root). They're per-operator-session
# captures of the MC's published kp/kd/target plus measured joint state
# for a nudge test, used to derive the values shipped in
# gear_sonic_deploy/configs/real_deploy_tuning/expressive.yaml. Re-run
# the scanner to regenerate; the YAML preset is the durable artifact.
mc_motor_scan_*.jsonl

# Standalone CMake build dir we use for the offline unit tests in
# gear_sonic_deploy/src/x2/agi_x2_deploy_onnx_ref/. The colcon build/
# directory is already covered by the toplevel build/ rule, but
# build_offline/ is hand-driven by `cmake -B build_offline ...` and won't
# match it.
build_offline/

# Python virtualenv at repo root (uv venv .venv)
.venv

# per-robot env created from x2_pc2/robot_env.env.template
x2_pc2/robot_env.env
*.pyc

